# Required: generate long random secrets (at least 32 chars for API key, 16 for admin password).
GATEWAY_API_KEY=REPLACE_WITH_A_LONG_RANDOM_API_KEY
GATEWAY_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_ADMIN_PASSWORD

# Public UI/API listener. TLS is required when binding publicly.
GATEWAY_BIND_IP=127.0.0.1
GATEWAY_CERT_DIR=./certs
GATEWAY_TLS_CERT_FILE=
GATEWAY_TLS_KEY_FILE=

# Internal defaults are already configured in compose.
